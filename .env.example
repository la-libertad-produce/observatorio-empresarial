# Cadena de conexión a PostgreSQL.
# En Supabase: Project Settings > Database > Connection string > "Transaction pooler" (puerto 6543).
DATABASE_URL=postgres://usuario:clave@localhost:5432/observatorio

# Credenciales del primer administrador (solo las usa `npm run db:seed`).
SEED_ADMIN_EMAIL=admin@ejemplo.pe
SEED_ADMIN_NOMBRE=Administrador UTF-CTI

# Si vale "true", el sitio muestra la franja de "datos referenciales".
NEXT_PUBLIC_MODO_DEMO=true
